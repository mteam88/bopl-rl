set working-directory := ".."
unity_editor := env("UNITY_EDITOR", "Unity")

# Standalone library and probes, profile-guided (tools/pgo_build.sh). Unity
# is only needed for live reference checks.
build:
    native/tools/pgo_build.sh

# The golden verification compares raw Q32.32 values against Unity captures,
# so it needs the bit-exact reference arithmetic. The default build stores
# `Fix` as an f64 for the rollout backend.
build-q32:
    cargo build --release --features q32 --manifest-path native/Cargo.toml

check:
    cargo fmt --manifest-path native/Cargo.toml -- --check
    cargo clippy --manifest-path native/Cargo.toml --all-targets -- -D warnings
    cargo clippy --manifest-path native/Cargo.toml --all-targets --features q32 -- -D warnings
    cargo test --manifest-path native/Cargo.toml
    cargo test --manifest-path native/Cargo.toml --features q32

verify: build-q32 check
    cc -std=c11 -Wall -Wextra -Werror -I native/include native/examples/smoke.c -L native/target/release -lbopl_sim -Wl,-rpath,'$ORIGIN/../target/release' -o native/target/c-smoke
    LD_LIBRARY_PATH=native/target/release native/target/c-smoke
    python3 native/tools/golden.py verify
    python3 native/tools/dynamics_golden.py verify
    python3 native/tools/physics_scene_golden.py verify
    python3 native/tools/physics_scene_golden.py verify --fixture native/fixtures/rope-scenes.jsonl.gz
    python3 native/tools/physics_capture_golden.py verify
    python3 native/tools/physics_capture_golden.py verify --fixture native/fixtures/beam-gameplay.jsonl.gz
    python3 native/tools/physics_capture_golden.py verify --fixture native/fixtures/beam-failure.jsonl.gz
