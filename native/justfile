set working-directory := ".."
unity_editor := env("UNITY_EDITOR", "Unity")

# Standalone library and probes. Unity is only needed for live reference checks.
build:
    cargo build --release --manifest-path native/Cargo.toml

check:
    cargo fmt --manifest-path native/Cargo.toml -- --check
    cargo clippy --manifest-path native/Cargo.toml --all-targets -- -D warnings
    cargo test --manifest-path native/Cargo.toml

verify: build check
    cc -std=c11 -Wall -Wextra -Werror -I native/include native/examples/smoke.c -L native/target/release -lbopl_sim -Wl,-rpath,'$ORIGIN/../target/release' -o native/target/c-smoke
    LD_LIBRARY_PATH=native/target/release native/target/c-smoke
    python3 native/tools/golden.py verify
    python3 native/tools/dynamics_golden.py verify
    python3 native/tools/physics_scene_golden.py verify
    python3 native/tools/physics_scene_golden.py verify --fixture native/fixtures/rope-scenes.jsonl.gz
    python3 native/tools/physics_capture_golden.py verify
    python3 native/tools/physics_capture_golden.py verify --fixture native/fixtures/beam-gameplay.jsonl.gz
    python3 native/tools/physics_capture_golden.py verify --fixture native/fixtures/beam-failure.jsonl.gz
    python3 native/tools/physics_capture_golden.py verify --fixture native/fixtures/elimination-physics.jsonl.gz
    python3 native/tools/physics_capture_golden.py verify --fixture native/fixtures/disabled-gameplay.jsonl.gz
    python3 native/tools/verify_beam.py --golden
    python3 native/tools/verify_beam.py --graph --golden
    python3 native/tools/verify_beam.py --stress --golden
    python3 native/tools/verify_beam_components.py --golden
    python3 native/tools/verify_beam_components.py --hitboxes --golden
    python3 native/tools/verify_beam_components.py --effects --golden
    python3 native/tools/verify_beam_scene.py --golden
    python3 native/tools/verify_beam_scene.py --stress --golden
    python3 native/tools/verify_rope.py --golden
    python3 native/tools/verify_random.py --golden
    python3 native/tools/verify_player_life.py --golden
    python3 native/tools/verify_player_life.py --golden --gameplay
    python3 native/tools/verify_player_collision.py --golden
    python3 native/tools/verify_player_collision.py --golden --gameplay
    python3 native/tools/verify_player_ground.py --golden
    python3 native/tools/verify_player_physics.py --golden
    python3 native/tools/verify_player_rays.py --golden
    python3 native/tools/verify_surface_motion.py --golden
    python3 native/tools/verify_player_controller.py --golden
    python3 native/tools/verify_animator.py --golden
    python3 native/tools/verify_animator.py --assets --golden
    python3 native/tools/verify_spawn.py --golden
    python3 native/tools/verify_scheduler.py --golden
    python3 native/tools/verify_scheduler.py --stress --golden
    python3 native/tools/verify_actors.py --golden
    python3 native/tools/verify_slime_actors.py --golden
    python3 native/tools/verify_slime_actors.py --faults --golden
    python3 native/tools/verify_ability_routing.py --golden
    python3 native/tools/verify_ragdoll.py --golden
    python3 native/tools/verify_ragdoll.py --faults --golden
    python3 native/tools/physics_scene_golden.py verify --fixture native/fixtures/disabled-colliders.jsonl.gz
    python3 native/tools/verify_player_body.py --golden
    python3 native/tools/verify_player_body.py --golden --gameplay
    python3 native/tools/test_python.py
    python3 native/tools/test_actor_stream.py
    python3 native/tools/verify_invisibility.py --golden
    python3 native/tools/verify_invisibility.py --faults --golden
    python3 native/tools/verify_invisibility_stream.py --golden
    python3 native/tools/verify_invisibility_stream.py --faults --golden
    python3 native/tools/verify_player_position.py --golden

verify-math: build
    dotnet build native/tools/math-oracle/math-oracle.csproj -c Release --nologo -v:q
    python3 native/tools/verify_math.py

unity-build:
    "{{unity_editor}}" -batchmode -nographics -quit -projectPath "$PWD" -executeMethod BuildScript.BuildLinux -logFile "$PWD/native-unity-build.log"

export-assets:
    "{{unity_editor}}" -batchmode -nographics -quit -projectPath "$PWD" -executeMethod ReferenceExport.Export -logFile "$PWD/native-export.log"

verify-geometry: build
    python3 native/tools/verify_geometry.py --cases 2000

benchmark: build
    python3 native/tools/benchmark.py

# Full-port verification layers (Unity player must be built with current probes).
verify-replay-codec:
    dotnet run --project native/tools/replay-codec -c Release -- selftest

verify-dynamics: build
    python3 native/tools/verify_dynamics.py --cases 3000

verify-pin:
    python3 native/tools/pin_reference.py --commit c5b73bb0e17f2a87a7c19d3de24d78403a910e77 --verify

verify-random: build
    dotnet build native/tools/random-oracle -c Release --nologo -v:q
    python3 native/tools/verify_random.py

