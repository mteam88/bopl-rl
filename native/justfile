verify-math: build
    dotnet build native/tools/math-oracle/math-oracle.csproj -c Release --nologo -v:q
    python3 native/tools/verify_math.py

unity-build:
    "{{unity_editor}}" -batchmode -nographics -quit -projectPath "$PWD/game" -executeMethod BuildScript.BuildLinux -logFile "$PWD/native-unity-build.log"

export-assets:
    "{{unity_editor}}" -batchmode -nographics -quit -projectPath "$PWD/game" -executeMethod ReferenceExport.Export -logFile "$PWD/native-export.log"

