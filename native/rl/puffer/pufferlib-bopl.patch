+// Bopl: grouped Newton-Schulz (BOPL_MUON_FUSED=1, default). Upstream runs
+// the 5 NS iterations one weight matrix at a time through cuBLAS: per matrix
+// 3 norm kernels + 5 x (gram GEMM, copy, A^2 GEMM, copy, update GEMM) + the
+// weight update = 29 launches, 174 per step for this policy's 6 matrices,
+// and the 128 x 128 grams (K = 946 / 384 / 278 / 256) land on 4 tensor-op
+// blocks each (~130 us apiece on a 16-SM partition): ~9.5 ms of a 40 ms
+// update. Here every 2-D parameter is orthogonalised in the same launch:
+// one normalise kernel (block per matrix), then per NS iteration three
+// grouped fp32 SIMT GEMM launches (gram, B = b A + c A^2, X' = a X + B X or
+// X B) whose grid is the union of all matrices' 64 x 64 output tiles, then
+// one fused weight update. 17 launches per step, ~0.6 ms. Plain fp32 FMAs
+// (the cuBLAS path runs TF32 by default); BOPL_MUON_FUSED=0 restores the
+// per-matrix cuBLAS path bit for bit.
+#define MUON_MAX_MATS 16
+#define MUON_TILE 64
+#define MUON_BK 16
+#define MUON_THREADS 256
+#define MUON_SMEM_STRIDE 68  // 64 + 4: k-major staging without 16-way bank conflicts, float4-aligned rows
+struct MuonGemm {
+    const float* A; const float* B; const float* Cin; float* C;
+    int M, N, K;                      // C(M, N) = alpha * A(M, K) @ B(K, N) + beta * Cin(M, N)
+    int sa_i, sa_k, sb_k, sb_j;       // A(i, k) = A[i sa_i + k sa_k], B(k, j) = B[k sb_k + j sb_j]
+    float alpha, beta;
+    int tile_begin, tiles_n;          // first tile of this problem in the grid, tiles along N
+};
