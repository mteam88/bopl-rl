+// Block per matrix: x /= max(||x||_F, eps), in place.
+__global__ void muon_grouped_normalize(MuonMats mats, float eps) {
+    __shared__ float sdata[256];
+    const MuonMatDesc& d = mats.m[blockIdx.x];
+    long n = (long)d.R * d.C;
+    float sum = 0.0f;
+    for (long i = threadIdx.x; i < n; i += blockDim.x) { float v = d.x[i]; sum += v * v; }
+    sdata[threadIdx.x] = sum;
+    __syncthreads();
+    for (int s = blockDim.x / 2; s > 0; s >>= 1) {
+        if (threadIdx.x < s) sdata[threadIdx.x] += sdata[threadIdx.x + s];
+        __syncthreads();
+    }
+    float inv = 1.0f / fmaxf(sqrtf(sdata[0]), eps);
+    for (long i = threadIdx.x; i < n; i += blockDim.x) d.x[i] *= inv;
