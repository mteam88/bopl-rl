+// Per-update statistics over learner rows (row % apb < primary): variance of
+// the raw GAE advantages and of the returns (adv + rollout value).
+__global__ void bopl_adv_stats(const precision_t* __restrict__ adv,
+        const precision_t* __restrict__ values, float* __restrict__ out,
+        int B, int T, int apb, int primary) {
+    __shared__ double sh[4][256];
+    int tid = threadIdx.x;
+    double sa = 0.0, saa = 0.0, sr = 0.0, srr = 0.0;
+    int total = B * T;
+    for (int i = tid; i < total; i += blockDim.x) {
+        int row = i / T;
+        if (row % apb >= primary) continue;
+        double a = to_float(adv[i]);
+        double r = a + to_float(values[i]);
+        sa += a; saa += a * a; sr += r; srr += r * r;
+    }
+    sh[0][tid] = sa; sh[1][tid] = saa; sh[2][tid] = sr; sh[3][tid] = srr;
+    __syncthreads();
+    for (int stride = blockDim.x / 2; stride > 0; stride >>= 1) {
+        if (tid < stride) {
+            for (int c = 0; c < 4; c++) sh[c][tid] += sh[c][tid + stride];
+        }
+        __syncthreads();
+    }
+    if (tid == 0) {
+        double n = (double)(B / apb) * (double)primary * (double)T;
+        double mean_a = sh[0][0] / n, mean_r = sh[2][0] / n;
+        double var_a = sh[1][0] / n - mean_a * mean_a;
+        double var_r = sh[3][0] / n - mean_r * mean_r;
+        out[0] = (float)var_a;
+        out[1] = (float)var_r;
+        out[2] = (float)mean_a;
+        out[3] = (float)n;
+    }
+}
