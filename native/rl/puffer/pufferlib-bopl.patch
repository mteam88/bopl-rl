+    for (int k0 = 0; k0 < g.K; k0 += MUON_BK) {
+        #pragma unroll
+        for (int r = 0; r < (MUON_TILE * MUON_BK) / MUON_THREADS; r++) {
+            int e = tid + r * MUON_THREADS;
+            int i, k;
+            if (a_kfast) { i = e / MUON_BK; k = e - i * MUON_BK; } else { k = e / MUON_TILE; i = e - k * MUON_TILE; }
+            int gi = row0 + i, gk = k0 + k;
+            As[k][i] = (gi < g.M && gk < g.K) ? g.A[(long)gi * g.sa_i + (long)gk * g.sa_k] : 0.0f;
+            int j, kb;
+            if (b_jfast) { kb = e / MUON_TILE; j = e - kb * MUON_TILE; } else { j = e / MUON_BK; kb = e - j * MUON_BK; }
+            int gj = col0 + j, gkb = k0 + kb;
+            Bs[kb][j] = (gj < g.N && gkb < g.K) ? g.B[(long)gkb * g.sb_k + (long)gj * g.sb_j] : 0.0f;
+        }
+        __syncthreads();
+        #pragma unroll
+        for (int k = 0; k < MUON_BK; k++) {
+            float4 a = *(const float4*)&As[k][ty * 4];
+            float4 b = *(const float4*)&Bs[k][tx * 4];
+            const float av[4] = {a.x, a.y, a.z, a.w}, bv[4] = {b.x, b.y, b.z, b.w};
+            #pragma unroll
+            for (int i = 0; i < 4; i++)
+                #pragma unroll
+                for (int j = 0; j < 4; j++) acc[i][j] = fmaf(av[i], bv[j], acc[i][j]);
+        }
+        __syncthreads();
+    }
+    #pragma unroll
+    for (int i = 0; i < 4; i++) {
+        int gi = row0 + ty * 4 + i;
+        if (gi >= g.M) continue;
+        #pragma unroll
+        for (int j = 0; j < 4; j++) {
+            int gj = col0 + tx * 4 + j;
+            if (gj >= g.N) continue;
+            long o = (long)gi * g.N + gj;
