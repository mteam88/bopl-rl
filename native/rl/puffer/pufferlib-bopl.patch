+        const int n = nt / a.T_seq, t = nt - n * a.T_seq;
+        const int logits_base = n * a.logits_stride_n + t * a.logits_stride_t;
+        const int values_idx = n * a.values_stride_n + t * a.values_stride_t;
+        const int grad_logits_base = nt * a.A_total;
+        const int mask_base = (a.action_mask != nullptr) ? n * a.mask_stride_n + t * a.mask_stride_t : 0;
