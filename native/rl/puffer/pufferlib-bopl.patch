+        const float old_logp = to_float(g.old_logprobs[nt]);
+        const float adv = to_float(g.advantages[nt]);
+        const float w = to_float(g.prio[n]);
+        const float val = to_float(g.values[nt]);
+        const float ret = to_float(g.returns[nt]);
+        const float val_pred = to_float(a.values_pred[values_idx]);
+        const float adv_std = sqrtf(float(a.adv_var[0]));
+        const float adv_normalized = (adv - float(a.adv_mean[0])) / (adv_std + 1e-8f);
+        const float dL = inv_NT;
+        const float ent_coef = *a.ent_coef;
+        const float d_entropy_term = dL * (-ent_coef);
+
+        // Value loss + gradient (identical to the per-thread kernel).
+        float v_error = val_pred - val;
+        float v_clipped = val + fmaxf(-a.vf_clip_coef, fminf(a.vf_clip_coef, v_error));
+        float v_loss_unclipped = (val_pred - ret) * (val_pred - ret);
+        float v_loss_clipped = (v_clipped - ret) * (v_clipped - ret);
+        float v_loss = 0.5f * fmaxf(v_loss_unclipped, v_loss_clipped);
+        bool use_clipped_vf = (v_loss_clipped > v_loss_unclipped);
