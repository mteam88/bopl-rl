+        int candidate = INT_MAX;
+        for (int a = a0; a < a1; ++a) {
+            cumsum += expf(row[logits_offset + a] - logsumexp);
+            if (rand_val < cumsum) { candidate = a; break; }
+        }
+        #pragma unroll
+        for (int off = 16; off > 0; off >>= 1) candidate = min(candidate, __shfl_xor_sync(0xffffffffu, candidate, off));
