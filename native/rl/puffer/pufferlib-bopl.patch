+// concurrent train_impl), and hand the slot to the trainer. Returns the
+// rollout's wall seconds.
+double rollouts_finish_impl(PuffeRL& pufferl) {
+    assert(pufferl.rollout_in_flight && "rollouts_finish: no rollout in flight");
+    double t_end = static_vec_omp_wait(pufferl.vec);
+    float sec = (float)(t_end - pufferl.rollout_t0);
+    pufferl.profile.accum[PROF_ROLLOUT] += sec * 1000.0f;  // store as ms
