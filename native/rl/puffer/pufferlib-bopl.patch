+        if (lane == 0) rand_val = curand_uniform(&state);
+        rand_val = __shfl_sync(0xffffffffu, rand_val, 0);
+
+        // Lane-local probability mass, exclusive prefix across lanes, then walk the chunk.
+        float local_mass = 0.0f;
+        for (int a = a0; a < a1; ++a) local_mass += expf(row[logits_offset + a] - logsumexp);
+        float prefix = local_mass;
+        #pragma unroll
