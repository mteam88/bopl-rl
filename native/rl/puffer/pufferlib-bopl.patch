+    // Stage the row (masked, nan_to_num) coalesced.
+    for (int a = lane; a < A_total && a < SAMPLE_MAX_LOGITS; a += 32)
+        row[a] = masked_logit(logits, logits_base, 0, a, action_mask, mask_base);
+    __syncwarp();
