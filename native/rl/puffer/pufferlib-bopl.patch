+__global__ void bopl_gather_start_states(precision_t* __restrict__ mb_state,
+        const precision_t* __restrict__ starts, const int* __restrict__ idx,
+        int mb_segs, int layers, int apb, int H) {
+    int i = blockIdx.x * blockDim.x + threadIdx.x;
+    if (i >= mb_segs * H) return;
+    int m = i / H, h = i % H;
+    int src = idx[m];
+    int buf = src / apb, local = src % apb;
+    for (int l = 0; l < layers; l++) {
+        mb_state[((long)l * mb_segs + m) * H + h] =
+            starts[(((long)buf * layers + l) * apb + local) * H + h];
+    }
+}
