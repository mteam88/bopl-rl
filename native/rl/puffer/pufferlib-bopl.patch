+        float sum_exp = local_sum;
+        #pragma unroll
+        for (int off = 16; off > 0; off >>= 1) sum_exp += __shfl_xor_sync(0xffffffffu, sum_exp, off);
+        const float logsumexp = local_max + logf(sum_exp);
