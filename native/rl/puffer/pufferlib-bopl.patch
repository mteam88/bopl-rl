+// Zero the recurrent state (all layers) of rows whose env terminal flag is set.
+// The Bopl env publishes terminal=1 together with the first observation of the
+// next episode, so "terminal at row r" means "reset before consuming obs r".
+__global__ void bopl_mask_state_rows(precision_t* __restrict__ state,
+        const float* __restrict__ terminals, int rows, int layers, int row_stride, int H) {
+    int idx = blockIdx.x * blockDim.x + threadIdx.x;
+    if (idx >= rows * H) return;
+    int r = idx / H, h = idx % H;
+    if (terminals[r] == 0.0f) return;
+    for (int l = 0; l < layers; l++) {
+        state[((long)l * row_stride + r) * H + h] = from_float(0.0f);
+    }
+}
+
+// Gather the rollout-start state of every sampled row into mb_state
+// (layers, mb_segs, H) from rollout_start_states (num_buffers, layers, apb, H).
+__global__ void bopl_gather_start_states(precision_t* __restrict__ mb_state,
+        const precision_t* __restrict__ starts, const int* __restrict__ idx,
+        int mb_segs, int layers, int apb, int H) {
+    int i = blockIdx.x * blockDim.x + threadIdx.x;
+    if (i >= mb_segs * H) return;
+    int m = i / H, h = i % H;
+    int src = idx[m];
+    int buf = src / apb, local = src % apb;
+    for (int l = 0; l < layers; l++) {
+        mb_state[((long)l * mb_segs + m) * H + h] =
+            starts[(((long)buf * layers + l) * apb + local) * H + h];
+    }
+}
