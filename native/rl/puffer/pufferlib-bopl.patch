+// Bopl: one handle (and so one workspace) per stream a thread issues GEMMs
+// on. The per-bank rollout branches run concurrently on side streams, and a
+// cuBLAS workspace must not be shared by concurrently running GEMMs; a graph
+// captured on a shared workspace would bake that race in. Same workspace size
+// everywhere so algorithm selection, and results, stay identical.
+#define CUBLAS_HANDLES_PER_THREAD 64  // 8 buffers x (1 + BOPL_MAX_BANK_STREAMS) side streams + warmup + train
+static cublasHandle_t cublas_get_handle(cudaStream_t stream) {
+    static thread_local cudaStream_t streams[CUBLAS_HANDLES_PER_THREAD];
+    static thread_local cublasHandle_t handles[CUBLAS_HANDLES_PER_THREAD];
+    static thread_local int count = 0;
+    for (int i = 0; i < count; i++) if (streams[i] == stream) return handles[i];
+    assert(count < CUBLAS_HANDLES_PER_THREAD && "too many distinct cuBLAS streams on one thread");
+    cublasHandle_t handle;
+    cublasCreate(&handle);
+    void* ws = nullptr;
+    cudaMalloc(&ws, CUBLAS_WS_BYTES);
+    cublasSetWorkspace(handle, ws, CUBLAS_WS_BYTES);
+    streams[count] = stream; handles[count] = handle; count++;
     return handle;
 }
 
+// Bopl: the fp32 GEMMs run on tensor cores as TF32 by default (inputs rounded
+// to a 10-bit mantissa, fp32 accumulate; ~1e-3 relative error per product,
+// gradient_norm moves ~1e-3 relative on update 1, learning curves track the
+// fp32 run over 300 updates). BOPL_TF32=0 restores exact fp32 cuBLAS.
+static cublasComputeType_t bopl_cublas_compute_type() {
+    static int tf32 = -1;
+    if (tf32 < 0) {
