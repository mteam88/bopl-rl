+            int k = buf * BOPL_MAX_BANK_STREAMS + i;
+            assert(cudaStreamCreateWithFlags(&pufferl->bank_streams[k], cudaStreamNonBlocking) == cudaSuccess);
+            assert(cudaEventCreateWithFlags(&pufferl->bank_join_events[k], cudaEventDisableTiming) == cudaSuccess);
+        }
+    }
+}
+
+static void bopl_bank_branches_free(PuffeRL& pufferl) {
+    if (!pufferl.bank_streams) return;
+    int num_buffers = pufferl.hypers.num_buffers;
+    for (int buf = 0; buf < num_buffers; buf++) {
+        cudaEventDestroy(pufferl.bank_fork_events[buf]);
+        for (int i = 0; i < BOPL_MAX_BANK_STREAMS; i++) {
+            int k = buf * BOPL_MAX_BANK_STREAMS + i;
+            cudaStreamDestroy(pufferl.bank_streams[k]);
+            cudaEventDestroy(pufferl.bank_join_events[k]);
+        }
+    }
+    free(pufferl.bank_streams); free(pufferl.bank_fork_events); free(pufferl.bank_join_events);
+    pufferl.bank_streams = nullptr; pufferl.bank_fork_events = nullptr; pufferl.bank_join_events = nullptr;
