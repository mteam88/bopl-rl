+        tf32 = (!USE_BF16 && (flag == nullptr || atoi(flag) != 0)) ? 1 : 0;
+    }
+    return tf32 ? CUBLAS_COMPUTE_32F_FAST_TF32 : CUBLAS_COMPUTE_PRECISION;
+}
