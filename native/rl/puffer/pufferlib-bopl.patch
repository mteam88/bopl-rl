+        if (lane == 0) {
+            float thread_loss = (pg_loss + a.vf_coef * v_loss - ent_coef * scaled_entropy) * inv_NT;
+            row_losses[warp][LOSS_PG] = pg_loss * inv_NT;
+            row_losses[warp][LOSS_VF] = v_loss * inv_NT;
+            row_losses[warp][LOSS_ENT] = total_entropy * inv_NT;
+            row_losses[warp][LOSS_TOTAL] = thread_loss;
+            row_losses[warp][LOSS_OLD_APPROX_KL] = (-logratio) * inv_NT;
+            row_losses[warp][LOSS_APPROX_KL] = ((ratio - 1.0f) - logratio) * inv_NT;
+            row_losses[warp][LOSS_CLIPFRAC] = (fabsf(ratio - 1.0f) > a.clip_coef ? 1.0f : 0.0f) * inv_NT;
+            row_losses[warp][LOSS_ENT_AIM] = (a.num_atns > 0 ? s_ent[warp][0] : 0.0f) * inv_NT;
+            row_losses[warp][LOSS_ENT_BUTTONS] = (a.num_atns > 1 ? s_ent[warp][1] : 0.0f) * inv_NT;
+            row_losses[warp][LOSS_ENT_HOLD] = (a.num_atns > 2 ? s_ent[warp][2] : 0.0f) * inv_NT;
+            row_losses[warp][LOSS_GRAD_NORM] = 0.0f;
+        }
+    } else if (lane == 0) {
