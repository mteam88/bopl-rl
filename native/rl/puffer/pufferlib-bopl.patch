+__global__ void __launch_bounds__(PPO_THREADS) ppo_loss_compute_warp(
+        float* __restrict__ ppo_partials,
+        PPOKernelArgs a, PPOGraphArgs g) {
+    __shared__ float s_lse[PPO_WARP_ROWS][MAX_ATN_HEADS];
+    __shared__ float s_ent[PPO_WARP_ROWS][MAX_ATN_HEADS];
+    __shared__ int s_act[PPO_WARP_ROWS][MAX_ATN_HEADS];
+    __shared__ int s_used[PPO_WARP_ROWS][MAX_ATN_HEADS];
+    __shared__ float row_losses[PPO_WARP_ROWS][LOSS_N];
