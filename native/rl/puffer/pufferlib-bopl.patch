+// Bopl async: begin a rollout into write_slot and return immediately. Snapshot
+// the learner params for the actor, zero (reset_state) and snapshot the
+// primary states the buffers start from, all on the (idle) train stream,
+// then make every buffer stream wait on that work and release the buffer
+// threads. The previous rollout has completed on the host (rollouts_finish)
+// and the previous train_impl ended with a stream sync, so nothing else
+// touches these tensors. Between start and finish the host must not read env
+// logs/counters or load bank weights (train.py orders those after finish).
+void rollouts_start_impl(PuffeRL& pufferl) {
+    assert(!pufferl.rollout_in_flight && "rollouts_start: a rollout is already in flight");
+    HypersT& hypers = pufferl.hypers;
+    cudaStream_t s = pufferl.train_stream;
+    int slot = pufferl.write_slot;
+
+    if (pufferl.num_slots > 1) {
+        cudaMemcpyAsync(pufferl.actor_param_puf.data, pufferl.param_puf.data,
+            numel(pufferl.param_puf.shape) * sizeof(precision_t), cudaMemcpyDeviceToDevice, s);
+    }
+    // Zero state buffers (primary + every frozen bank, so all banks see fresh
+    // state symmetrically — otherwise frozen banks accumulate indefinitely while
+    // primary resets, giving primary an unfair in-distribution advantage).
+    if (hypers.reset_state) {
+        for (int i = 0; i < hypers.num_buffers; i++) {
+            puf_zero(&pufferl.buffer_states[i], s);
+        }
+        for (int b = 0; b < pufferl.num_frozen_banks; b++) {
+            for (int i = 0; i < hypers.num_buffers; i++) {
+                puf_zero(&pufferl.frozen_banks[b].buffer_states[i], s);
+            }
+        }
+    }
+    // Bopl: remember the primary state every buffer starts this rollout with;
+    // training sequences are initialized from it (see bopl_gather_start_states).
+    {
+        precision_t* starts = rollout_start_states_slot(pufferl, slot);
+        long per_buf = numel(pufferl.rollout_start_states.shape) / pufferl.num_slots / hypers.num_buffers;
+        for (int i = 0; i < hypers.num_buffers; i++) {
+            assert(numel(pufferl.buffer_states[i].shape) == per_buf && "rollout_start_states shape mismatch");
+            cudaMemcpyAsync(starts + i * per_buf, pufferl.buffer_states[i].data,
+                per_buf * sizeof(precision_t), cudaMemcpyDeviceToDevice, s);
+        }
+    }
+    assert(cudaEventRecord(pufferl.rollout_ready_event, s) == cudaSuccess);
+    for (int i = 0; i < hypers.num_buffers; i++) {
+        assert(cudaStreamWaitEvent(pufferl.streams[i], pufferl.rollout_ready_event, 0) == cudaSuccess);
+    }
