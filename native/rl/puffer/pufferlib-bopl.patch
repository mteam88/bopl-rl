+// Bopl: warp-per-row discrete sampler. Upstream's one-thread-per-row loop over
+// 277 logits with accurate expf ran ~66 us per bank step on 112 rows (4 warps
+// on 1 SM). Here a warp shares one row: the row's logits are staged in shared
+// memory, each lane owns a contiguous chunk of each head, the CDF walk is a
+// lane-local scan on top of an exclusive warp prefix, and lane 0 owns the
+// Philox state so the uniform sequence is identical to upstream. Only the
+// summation order of the CDF differs (fp32 rounding at head boundaries).
+#define SAMPLE_WARP_ROWS 8
+#define SAMPLE_MAX_LOGITS 512
+__global__ void __launch_bounds__(SAMPLE_WARP_ROWS * 32) sample_logits_warp(
+        PrecisionTensor dec_out, IntTensor act_sizes_puf,
+        precision_t* __restrict__ actions, precision_t* __restrict__ logprobs,
