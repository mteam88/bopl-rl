+// Driver mode (BOPL_ENV_DRIVER=1): one thread owns every buffer's stream. It
+// launches forward + D2H per buffer, polls the streams round-robin, publishes
+// each buffer's env job the moment its actions land, and uploads the moment
+// the job's last env finishes. Buffers are never blocked on each other or on
+// their own stragglers, and only one hardware thread is spent on the GPU
+// handshake instead of one per buffer.
+static void bopl_driver_launch(StaticVec* vec, StaticOMPArg* a, int buf) {
+    StaticThreading* th = vec->threading;
+    BoplEnvJob* job = &th->jobs[buf];
+    int agents_per_buffer = vec->agents_per_buffer;
+    int agent_start = buf * agents_per_buffer;
+    if (a->thread_init) a->thread_init(a->ctx, buf);  // thread-local stream = this buffer's
+    job->t_launch = bopl_now_ns();
+    a->net_callback(a->ctx, buf, job->t);
+    cudaMemcpyAsync(
+        &vec->actions[agent_start * NUM_ATNS],
+        &vec->gpu_actions[agent_start * NUM_ATNS],
+        agents_per_buffer * NUM_ATNS * sizeof(float),
+        cudaMemcpyDeviceToHost, vec->streams[buf]);
+    job->state = BOPL_BUF_GPU;
+}
