+        logits_offset = 0;
+        for (int h = 0; h < a.num_atns; ++h) {
+            int A = a.act_sizes[h];
+            int used = s_used[warp][h];
+            if (!used) {
+                for (int j = lane; j < A; j += 32) a.grad_logits[grad_logits_base + logits_offset + j] = 0.0f;
+                logits_offset += A;
+                continue;
+            }
+            int act = s_act[warp][h];
+            float logsumexp = s_lse[warp][h], ent = s_ent[warp][h];
+            float d_entropy_head = d_entropy_term * a.ent_coef[1 + h];
+            for (int j = lane; j < A; j += 32) {
+                float l = load_logit_masked(a.logits, logits_base, a.logits_stride_a, logits_offset, j, a.action_mask, mask_base);
+                float logp = l - logsumexp;
+                float p = __expf(logp);
+                float d_logit = (j == act) ? d_new_logp : 0.0f;
+                d_logit -= p * d_new_logp;
+                d_logit += d_entropy_head * p * (-ent - logp);
+                a.grad_logits[grad_logits_base + logits_offset + j] = d_logit;
+            }
+            logits_offset += A;
+        }
+
+        if (lane == 0) {
+            float thread_loss = (pg_loss + a.vf_coef * v_loss - ent_coef * scaled_entropy) * inv_NT;
+            row_losses[warp][LOSS_PG] = pg_loss * inv_NT;
+            row_losses[warp][LOSS_VF] = v_loss * inv_NT;
+            row_losses[warp][LOSS_ENT] = total_entropy * inv_NT;
+            row_losses[warp][LOSS_TOTAL] = thread_loss;
+            row_losses[warp][LOSS_OLD_APPROX_KL] = (-logratio) * inv_NT;
+            row_losses[warp][LOSS_APPROX_KL] = ((ratio - 1.0f) - logratio) * inv_NT;
+            row_losses[warp][LOSS_CLIPFRAC] = (fabsf(ratio - 1.0f) > a.clip_coef ? 1.0f : 0.0f) * inv_NT;
+            row_losses[warp][LOSS_ENT_AIM] = (a.num_atns > 0 ? s_ent[warp][0] : 0.0f) * inv_NT;
+            row_losses[warp][LOSS_ENT_BUTTONS] = (a.num_atns > 1 ? s_ent[warp][1] : 0.0f) * inv_NT;
+            row_losses[warp][LOSS_ENT_HOLD] = (a.num_atns > 2 ? s_ent[warp][2] : 0.0f) * inv_NT;
+            row_losses[warp][LOSS_GRAD_NORM] = 0.0f;
+        }
+    } else if (lane == 0) {
+        for (int c = 0; c < LOSS_N; c++) row_losses[warp][c] = 0.0f;
+    }
+    __syncthreads();
+    if (tid < LOSS_N) {
+        float sum = 0.0f;
+        for (int r = 0; r < PPO_WARP_ROWS; r++) sum += row_losses[r][tid];
+        int base = blockIdx.x * (LOSS_N + 1);
+        if (tid == LOSS_TOTAL) ppo_partials[base] = sum;
+        ppo_partials[base + 1 + tid] = sum;
+    }
+}
