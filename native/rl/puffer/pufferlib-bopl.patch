+// One 64 x 64 output tile of one problem per block; 4 x 4 outputs per thread.
+__global__ void __launch_bounds__(MUON_THREADS) muon_grouped_gemm(MuonGroup grp) {
+    __shared__ __align__(16) float As[MUON_BK][MUON_SMEM_STRIDE];
+    __shared__ __align__(16) float Bs[MUON_BK][MUON_SMEM_STRIDE];
+    int tile = blockIdx.x, p = 0;
