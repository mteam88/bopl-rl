+struct MuonMatDesc {
+    float* x;          // gradient block (R, C), row-major, also NS ping buffer
+    float* x_buf;      // NS pong buffer (R, C)
+    float* gram;       // (M, M)
+    float* gram_buf;   // (M, M)
+    long offset;       // element offset in the flat parameter buffer
+    int R, C, M, N;    // M = min(R, C), N = max(R, C)
+    int tall;          // R > C: gram = X^T X, X' = X B; else gram = X X^T, X' = B X
+    float scale;       // sqrt(max(1, R / C))
+};
+struct MuonMats {
+    MuonMatDesc m[MUON_MAX_MATS];
+    int count;
+    long total;        // total parameter count (2-D and other)
