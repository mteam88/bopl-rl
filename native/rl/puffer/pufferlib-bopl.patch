+// Bopl: warp-per-row version of ppo_loss_compute for discrete heads. Upstream
+// gives every (n, t) one thread that walks all A_total = 277 logits three
+// times with a stride of 278 floats between neighbouring threads, so a warp's
+// load touches 32 cache lines for 32 useful floats and the kernel runs at
+// ~1.2 ms per minibatch. Here the 32 lanes of a warp share one row and read
+// consecutive logits; per-head sums are warp shuffles. Same arithmetic per
+// element, different summation order.
+#define PPO_WARP_ROWS (PPO_THREADS / 32)
+__device__ __forceinline__ float warp_sum(float v) {
+    #pragma unroll
+    for (int off = 16; off > 0; off >>= 1) v += __shfl_xor_sync(0xffffffffu, v, off);
+    return v;
+}
+__device__ __forceinline__ float warp_max(float v) {
+    #pragma unroll
+    for (int off = 16; off > 0; off >>= 1) v = fmaxf(v, __shfl_xor_sync(0xffffffffu, v, off));
+    return v;
+}
