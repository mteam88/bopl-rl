<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>disable</Nullable>
    <LangVersion>latest</LangVersion>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <AssemblyName>Host</AssemblyName>
    <RootNamespace>BoplSim.Host</RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../UnityShim/UnityShim.csproj" />
    <ProjectReference Include="../Gameplay/Gameplay.csproj" />
    <ProjectReference Include="../Export/Export.csproj" />
  </ItemGroup>

  <!-- NativeAOT spike (sim/Oracle/AOT-SPIKE.md): reflection roots for the
       string-driven Export loader. No effect on regular builds. -->
  <ItemGroup Condition="'$(PublishAot)' == 'true'">
    <RdXmlFile Include="rd.xml" />
  </ItemGroup>

</Project>
