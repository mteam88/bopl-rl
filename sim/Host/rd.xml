<!-- NativeAOT reflection roots (AOT spike - sim/Oracle/AOT-SPIKE.md).
     The Export loader activates gameplay/shim types by exported name
     (ExportDatabase.ResolveType -> Activator.CreateInstance) and resolves
     fields/methods by string (PropertyApplier.ResolveMember,
     MonoBehaviour.MessagesFor, PersistentCall.FindMethod), so ILC cannot see
     the reflected members statically. Root both assemblies wholesale; the
     alternative (per-type [DynamicallyAccessedMembers] annotations or a
     generated dispatch table) is tracked in sim/Oracle/AOT.md. -->
<Directives>
  <Application>
    <Assembly Name="Gameplay" Dynamic="Required All" />
    <Assembly Name="UnityShim" Dynamic="Required All" />
    <!-- Constructed generics the loader Activator.CreateInstance's by Type
         object (list fields sized via AllocateSized). Assembly-level roots do
         NOT cover CoreLib instantiations; each needs an explicit entry.
         Proof-of-concept entry - the full closed set should be generated by
         scanning gameplay serialized fields (see AOT-SPIKE.md). -->
    <Assembly Name="System.Private.CoreLib">
      <!-- WorldCopier (post-warmup snapshots, stage 5 reset item 2) deep-copies
           CoreLib collections by reflecting their private fields; each closed
           instantiation reachable from a world snapshot needs a root. The set
           below is generated by `BOPL_SNAPSHOT_AUDIT=1 Host worlds ...` across
           all maps and several loadouts; a missing entry throws at capture
           time and the sim falls back to full resets (loud, never wrong). -->
      <Type Name="System.Collections.Generic.Dictionary`2+Entry[[System.Int32,System.Private.CoreLib],[UnityEngine.Texture,UnityShim]]" Dynamic="Required All" />
      <Type Name="System.Collections.Generic.Dictionary`2+Entry[[System.String,System.Private.CoreLib],[System.Object,System.Private.CoreLib]]" Dynamic="Required All" />
      <Type Name="System.Collections.Generic.Dictionary`2+Entry[[UnityEngine.Sprite,UnityShim],[System.UInt32,System.Private.CoreLib]]" Dynamic="Required All" />
      <Type Name="System.Collections.Generic.Dictionary`2[[System.Int32,System.Private.CoreLib],[System.Int32,System.Private.CoreLib]]" Dynamic="Required All" />
      <Type Name="System.Collections.Generic.Dictionary`2[[System.Int32,System.Private.CoreLib],[System.Single,System.Private.CoreLib]]" Dynamic="Required All" />
